PORT=3000
DB_PATH=./data/matcha-duo.sqlite
# Kosongkan keduanya untuk mode WiFi pribadi tanpa PIN.
MORENO_PIN=
CAHYA_PIN=
# Set true hanya jika diakses melalui HTTPS (tunnel/hosting).
COOKIE_SECURE=false
# Hosting gratis: isi dari Neon Connect, simpan hanya di server.
DATABASE_URL=

# Google Calendar OAuth: see GOOGLE-CALENDAR.md. Keep these only on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://snoomy.vercel.app/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
