{
  "manifest_version": 3,
  "name": "Snoomy × SIAP",
  "version": "1.0.0",
  "description": "Kirim jadwal kuliah SIAP Undip ke Snoomy otomatis setelah kamu login SSO sendiri.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://siap.undip.ac.id/*",
    "https://snoomy.vercel.app/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://siap.undip.ac.id/*"],
      "js": ["siap-table.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Snoomy × SIAP",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
